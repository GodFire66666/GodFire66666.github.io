---
import Header from "../components/Header.astro";
import { SITE } from "../config";
import "../styles/global.css";

interface Props {
  title?: string;
  titleZh?: string;
  description?: string;
  descriptionZh?: string;
  immersive?: boolean;
  wide?: boolean;
}

const {
  title,
  titleZh,
  description = SITE.description,
  descriptionZh = SITE.descriptionZh,
  immersive = false,
  wide = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const pageTitleZh = titleZh ? `${titleZh} · ${SITE.titleZh}` : SITE.titleZh;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={SITE.language} class="lang-en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfbf8" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const language = localStorage.getItem("yucong-site-language");
        if (language === "zh") {
          document.documentElement.classList.replace("lang-en", "lang-zh");
          document.documentElement.lang = "zh-CN";
        }
      } catch {
        // Keep the English default when storage is unavailable.
      }
    </script>
  </head>
  <body
    data-title-en={pageTitle}
    data-title-zh={pageTitleZh}
    data-description-en={description}
    data-description-zh={descriptionZh}
  >
    <div class:list={["page-shell", { "page-shell--immersive": immersive, "page-shell--wide": wide }]}>
      <Header overlay={immersive} />
      <main class:list={{ "main--immersive": immersive }}>
        <slot />
      </main>
      <footer>
        <span>© {new Date().getFullYear()} {SITE.author}</span>
        <span class="en-text">Notes that grow over time.</span>
        <span class="zh-text">让笔记随时间生长。</span>
      </footer>
    </div>
  </body>
</html>
