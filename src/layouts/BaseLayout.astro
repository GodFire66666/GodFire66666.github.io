---
import Header from "../components/Header.astro";
import { SITE } from "../config";
import "../styles/global.css";

interface Props {
  title?: string;
  titleZh?: string;
  description?: string;
  descriptionZh?: string;
  immersive?: boolean;
  detail?: boolean;
  wide?: boolean;
}

const {
  title,
  titleZh,
  description = SITE.description,
  descriptionZh = SITE.descriptionZh,
  immersive = false,
  detail = false,
  wide = false,
} = Astro.props;
const pageTitle = title ? `${title} · ${SITE.title}` : SITE.title;
const pageTitleZh = titleZh ? `${titleZh} · ${SITE.titleZh}` : SITE.titleZh;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang={SITE.language} class="lang-en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfbf8" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{pageTitle}</title>
    <script is:inline>
      try {
        const language = localStorage.getItem("yucong-site-language");
        if (language === "zh") {
          document.documentElement.classList.replace("lang-en", "lang-zh");
          document.documentElement.lang = "zh-CN";
        }
        const transitionColor = sessionStorage.getItem("yucong-transition-color");
        if (sessionStorage.getItem("yucong-page-transition") === "1") {
          document.documentElement.classList.add("page-transition-arriving");
          if (transitionColor) {
            document.documentElement.style.setProperty("--route-color", transitionColor);
          }
          sessionStorage.removeItem("yucong-page-transition");
          sessionStorage.removeItem("yucong-transition-color");
        }
      } catch {
        // Keep the English default when storage is unavailable.
      }
    </script>
  </head>
  <body
    data-title-en={pageTitle}
    data-title-zh={pageTitleZh}
    data-description-en={description}
    data-description-zh={descriptionZh}
  >
    <div class:list={["page-shell", { "page-shell--immersive": immersive, "page-shell--detail": detail, "page-shell--wide": wide }]}>
      <Header overlay={immersive} detail={detail} />
      <main class:list={{ "main--immersive": immersive }}>
        <slot />
      </main>
      <footer>
        <span>© {new Date().getFullYear()} {SITE.author}</span>
        <span class="en-text">Notes that grow over time.</span>
        <span class="zh-text">让笔记随时间生长。</span>
      </footer>
    </div>
    <div class="page-transition-curtain" aria-hidden="true"></div>
    <script is:inline>
      const transitionDelay = 520;

      function navigateWithCurtain(href, color) {
        if (!href) return;
        document.documentElement.style.setProperty("--route-color", color || "#111214");
        document.documentElement.classList.add("page-is-leaving");
        try {
          sessionStorage.setItem("yucong-page-transition", "1");
          sessionStorage.setItem("yucong-transition-color", color || "#111214");
        } catch {}
        window.setTimeout(() => window.location.assign(href), transitionDelay);
      }

      document.addEventListener("click", (event) => {
        const link = event.target instanceof Element
          ? event.target.closest("a[data-transition-link]")
          : null;
        if (!(link instanceof HTMLAnchorElement)) return;
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey ||
          event.ctrlKey ||
          event.shiftKey ||
          event.altKey ||
          link.target === "_blank"
        ) return;
        const url = new URL(link.href, window.location.href);
        if (url.origin !== window.location.origin) return;
        event.preventDefault();
        navigateWithCurtain(url.href, link.dataset.transitionColor);
      });

      window.addEventListener("site-transition-navigate", (event) => {
        navigateWithCurtain(event.detail?.href, event.detail?.color);
      });

      window.addEventListener("pageshow", () => {
        document.documentElement.classList.remove("page-is-leaving");
      });
    </script>
  </body>
</html>
