---
import BaseLayout from "./BaseLayout.astro";
import DetailScrollCue from "../components/DetailScrollCue.astro";

interface MetaItem {
  label: string;
  labelZh: string;
  value: string;
  valueZh: string;
}

interface Props {
  part: string;
  totalParts?: string;
  title: string;
  titleZh: string;
  pageTitle?: string;
  pageTitleZh?: string;
  eyebrow: string;
  eyebrowZh: string;
  statement: string;
  statementZh: string;
  description: string;
  descriptionZh: string;
  image: string;
  imageAlt: string;
  imageAspect?: number;
  imageWidth?: number;
  background: string;
  foreground: string;
  accent: string;
  heroBackground?: string;
  heroForeground?: string;
  heroAccent?: string;
  heroOutline?: string;
  meta: MetaItem[];
  nextHref: string;
  nextTitle: string;
  nextTitleZh: string;
  nextImage: string;
  nextImageAspect?: number;
  nextImageWidth?: number;
  nextBackground: string;
  nextAccent: string;
  nextRail?: string;
  imagePosition?: string;
  titleLeft?: string;
  titleLeftZh?: string;
  showOverview?: boolean;
  showHeroTitle?: boolean;
  outlineHeroTitle?: boolean;
}

const {
  part,
  totalParts = "05",
  title,
  titleZh,
  pageTitle,
  pageTitleZh,
  eyebrow,
  eyebrowZh,
  statement,
  statementZh,
  description,
  descriptionZh,
  image,
  imageAlt,
  imageAspect = 1366 / 844,
  imageWidth,
  background,
  foreground,
  accent,
  heroBackground = background,
  heroForeground = foreground,
  heroAccent = accent,
  heroOutline = heroForeground,
  meta,
  nextHref,
  nextTitle,
  nextTitleZh,
  nextImage,
  nextImageAspect = 1366 / 844,
  nextImageWidth,
  nextBackground,
  nextAccent,
  nextRail = nextAccent,
  imagePosition = "center",
  titleLeft = "8%",
  titleLeftZh = titleLeft,
  showOverview = true,
  showHeroTitle = true,
  outlineHeroTitle = true,
} = Astro.props;
const titleWords = title.trim().split(/\s+/);
const detailMediaWidth = imageWidth ?? Math.min(52, 33.75 * imageAspect);
const detailMediaHeight = detailMediaWidth / imageAspect;
const detailMediaTop = (56.25 - detailMediaHeight) / 2;
const detailMediaSide = (100 - detailMediaWidth) / 2;
const nextMediaWidth = nextImageWidth ?? Math.min(52, 33.75 * nextImageAspect);
const nextMediaHeight = nextMediaWidth / nextImageAspect;
---

<BaseLayout
  immersive
  detail
  title={pageTitle ?? title}
  titleZh={pageTitleZh ?? titleZh}
  description={description}
  descriptionZh={descriptionZh}
  detailBackground={heroBackground}
  detailForeground={heroForeground}
  detailAccent={heroAccent}
  detailReturnColor={heroBackground}
>
  <article
    class="part-detail"
    data-part-detail
    style={`--detail-bg:${background};--detail-fg:${foreground};--detail-accent:${accent};--detail-hero-bg:${heroBackground};--detail-hero-fg:${heroForeground};--detail-hero-accent:${heroAccent};--detail-hero-outline:${heroOutline};--detail-image-position:${imagePosition};--detail-image-aspect:${imageAspect};--detail-media-width:${detailMediaWidth}cqw;--detail-media-height:${detailMediaHeight}cqw;--detail-media-top:${detailMediaTop}cqw;--detail-media-side:${detailMediaSide}cqw;--detail-title-left:${titleLeft};--detail-title-left-zh:${titleLeftZh};`}
  >
    <section class="detail-hero" aria-labelledby="detail-title">
      <div class="detail-hero-stage" style={`--detail-stage-height-limit:${50.5 / detailMediaHeight * 100}svh`}>
        <div class="detail-hero-copy">
          <p class="detail-part">{part} / {totalParts}</p>
          <p class="detail-eyebrow">
            <span class="en-text">{eyebrow}</span>
            <span class="zh-text">{eyebrowZh}</span>
          </p>
          <h1
            id="detail-title"
            class:list={{
              "detail-title-display": true,
              "detail-title--compound": titleWords.length > 1,
              "detail-title--visually-hidden": !showHeroTitle,
            }}
          >
            <span class="en-text detail-title-en">
              {titleWords.map((word) => (
                <span class="detail-title-word">
                  {word}
                </span>
              ))}
            </span>
            <span class="zh-text">{titleZh}</span>
          </h1>
        </div>
        <figure class="detail-hero-media" data-route-cover>
          <img src={image} alt={imageAlt} loading="eager" fetchpriority="high" />
        </figure>
        {outlineHeroTitle && showHeroTitle && (
          <div class="detail-title-mask" aria-hidden="true">
            <div class="detail-hero-copy detail-hero-copy--mask">
              <p class="detail-part">{part} / {totalParts}</p>
              <p class="detail-eyebrow">
                <span class="en-text">{eyebrow}</span>
                <span class="zh-text">{eyebrowZh}</span>
              </p>
              <div
                class:list={{
                  "detail-title-display": true,
                  "detail-title--compound": titleWords.length > 1,
                  "detail-title--outline": true,
                }}
              >
                <span class="en-text detail-title-en">
                  {titleWords.map((word) => (
                    <span class="detail-title-word">{word}</span>
                  ))}
                </span>
                <span class="zh-text">{titleZh}</span>
              </div>
            </div>
          </div>
        )}
      </div>
      <DetailScrollCue />
    </section>

    {showOverview && (
      <section class="detail-overview" data-detail-reveal>
        <div class="detail-overview-heading">
          <p>
            <span class="en-text">About this part</span>
            <span class="zh-text">关于这一部分</span>
          </p>
          <h2>
            <span class="en-text">{statement}</span>
            <span class="zh-text">{statementZh}</span>
          </h2>
        </div>
        <div class="detail-overview-copy">
          <p>
            <span class="en-text">{description}</span>
            <span class="zh-text">{descriptionZh}</span>
          </p>
          <dl>
            {meta.map((item) => (
              <div>
                <dt>
                  <span class="en-text">{item.label}</span>
                  <span class="zh-text">{item.labelZh}</span>
                </dt>
                <dd>
                  <span class="en-text">{item.value}</span>
                  <span class="zh-text">{item.valueZh}</span>
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    )}

    <div class="detail-content">
      <slot />
    </div>

    <section
      class="detail-next"
      id="next-part"
      data-detail-next
      style={`--next-bg:${nextBackground};--next-accent:${nextAccent};--next-media-width:${nextMediaWidth}cqw;--next-media-height:${nextMediaHeight}cqw;--next-aspect:${nextImageAspect};`}
    >
      <a
        href={nextHref}
        data-next-part-link
        data-transition-color={nextBackground}
        data-transition-accent={nextRail}
        data-transition-image={nextImage}
        data-transition-aspect={nextImageAspect}
        aria-label={`Continue to ${nextTitle}`}
      >
        <span class="detail-next-progress" aria-hidden="true"></span>
        <span class="detail-next-kicker"><span class="en-text">Next part</span><span class="zh-text">下一部分</span></span>
        <div class="detail-next-stage" style={`--detail-stage-height-limit:${50.5 / nextMediaHeight * 100}svh`}>
          <div class="detail-next-media" data-next-media>
            <img src={nextImage} alt="" loading="lazy" class="detail-next-monochrome" />
            <img src={nextImage} alt="" loading="lazy" class="detail-next-color" />
          </div>
          <h2 class:list={["detail-next-title", { "detail-next-title--compound": nextTitle.includes(" ") }]}>
            <span class="en-text">{nextTitle}</span><span class="zh-text">{nextTitleZh}</span>
          </h2>
          <div class="detail-next-outline-clip" aria-hidden="true">
            <div class:list={["detail-next-title", "detail-next-title--outline", { "detail-next-title--compound": nextTitle.includes(" ") }]}>
              <span class="en-text">{nextTitle}</span><span class="zh-text">{nextTitleZh}</span>
            </div>
          </div>
        </div>
      </a>
    </section>
  </article>
</BaseLayout>

<script>
  import "../scripts/detail-next";
  let detailController: AbortController | undefined;
  let detailObserver: IntersectionObserver | undefined;
  let detailEnterFrame = 0;

  function stopPartDetail() {
    detailController?.abort();
    detailController = undefined;
    detailObserver?.disconnect();
    detailObserver = undefined;
    window.cancelAnimationFrame(detailEnterFrame);
    document.documentElement.classList.remove("part-detail-active");
  }

  function initializePartDetail() {
    stopPartDetail();
    const detailPage = document.querySelector<HTMLElement>("[data-part-detail]");
    if (!detailPage) return;

    detailController = new AbortController();
    const { signal } = detailController;
    const revealElements = Array.from(
      detailPage.querySelectorAll<HTMLElement>("[data-detail-reveal]"),
    );
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    document.documentElement.classList.add("part-detail-active");
    detailEnterFrame = requestAnimationFrame(() => {
      if (!signal.aborted) detailPage.classList.add("detail-entered");
    });

    if (!reducedMotion.matches) {
      detailObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) entry.target.classList.add("detail-visible");
          });
        },
        { rootMargin: "0px 0px -8% 0px", threshold: 0 },
      );
      revealElements.forEach((element) => detailObserver?.observe(element));
    } else {
      revealElements.forEach((element) => element.classList.add("detail-visible"));
    }

  }

  document.addEventListener("astro:page-load", initializePartDetail);
  document.addEventListener("astro:before-swap", stopPartDetail);
  initializePartDetail();
</script>
