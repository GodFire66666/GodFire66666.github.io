const photoPath = (slug: string, index: number) =>
  `/photography/${slug}/gallery/${String(index).padStart(2, "0")}.webp`;
const totalPhotographs = series.reduce((total, item) => total + item.count, 0);
const meta = [
  { label: "Archive", labelZh: "存档", value: `${series.length} series`, valueZh: `${series.length} 组作品` },
  { label: "Photographs", labelZh: "照片", value: `${totalPhotographs} images`, valueZh: `${totalPhotographs} 张` },
  { label: "Years", labelZh: "年份", value: "2021–2022", valueZh: "2021–2022" },
];
---

<PartDetailLayout
  part="02"
  title="Model Photography"
  titleZh="模型摄影"
  eyebrow={`${series.length} Series · ${totalPhotographs} Photographs`}
  eyebrowZh={`${series.length} 组作品 · ${totalPhotographs} 张照片`}
  statement="Small worlds, shaped by light."
  statementZh="用光线，让模型拥有自己的世界。"
  description="An archive from the years when I photographed scale models: posing, lighting, and building a believable moment inside a very small frame."
  descriptionZh="这是我曾经拍摄比例模型时留下的完整存档：调整姿态、布置光线，在很小的画幅里构建一个可信的瞬间。"
  image="/photography/rg-hi-nu/gallery/13.webp"
  imageAlt="RG Hi-Nu Gundam posed with its rifle against a dark background"
  imageAspect={1600 / 1067}
  imagePosition="center"
  titleLeft="5.5%"
  titleLeftZh="10%"
  background="#172536"
  foreground="#eef2f1"
  accent="#88b2cf"
  heroBackground="#a8bdcb"
  heroForeground="#172536"
  heroAccent="#294d65"
  heroOutline="#f0f3f2"
  {meta}
  nextHref="/notes/"
  nextTitle="Notes"
  nextTitleZh="随笔"
  nextImage="/notes/pampas-clouds-cover.png"
  nextImageAspect={1448 / 1086}
  nextBackground="#326b7e"
  nextImageWidth={52}
  nextAccent="#f0d09a"
  nextRail="#f0d09a"
>
  <section class="photography-series-list detail-photography-collection" aria-label="Model photography archive">
    {series.map((item, index) => (
      <article class:list={["photography-series", { "photography-series--reverse": index % 2 === 1 }]} id={item.slug}>
        <header class="photography-series-copy">
          <p class="photography-series-number">{String(index + 1).padStart(2, "0")} / {String(series.length).padStart(2, "0")}</p>
          <p class="photography-series-category"><span class="en-text">{item.category}</span><span class="zh-text">{item.categoryZh}</span></p>
          <h2><span class="en-text">{item.title}</span><span class="zh-text">{item.titleZh}</span></h2>
          <p class="photography-series-description"><span class="en-text">{item.description}</span><span class="zh-text">{item.descriptionZh}</span></p>
          <a href={item.source} target="_blank" rel="noreferrer"><span class="en-text">View original post</span><span class="zh-text">查看原帖</span><span aria-hidden="true">↗</span></a>
        </header>
        <div class="photography-series-images">
          {item.featured.map((photoNumber, imageIndex) => (
            <figure class:list={["photography-shot", `photography-shot--${imageIndex + 1}`]}>
              <img src={photoPath(item.slug, photoNumber)} alt={`${item.title} photograph ${photoNumber}`} loading={index === 0 ? "eager" : "lazy"} decoding="async" />
            </figure>
          ))}
        </div>
        <details class="photography-full-series">
          <summary>
            <span class="en-text">View complete series · {item.count} photographs</span>
            <span class="zh-text">查看完整组图 · {item.count} 张</span>
            <span aria-hidden="true" class="photography-summary-icon">+</span>
          </summary>
          <div class="photography-full-grid">
            {Array.from({ length: item.count }, (_, photoIndex) => (
              <figure><img src={photoPath(item.slug, photoIndex + 1)} alt={`${item.title} photograph ${photoIndex + 1}`} loading="lazy" decoding="async" /></figure>
            ))}
          </div>
        </details>
      </article>
    ))}
  </section>
</PartDetailLayout>
