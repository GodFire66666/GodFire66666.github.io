---
import BaseLayout from "../layouts/BaseLayout.astro";
import { projects } from "../data/projects";
---

<BaseLayout
  title="Projects"
  titleZh="项目"
  description="Selected projects designed and built by Yucong Luo."
  descriptionZh="Yucong Luo 设计与构建的精选项目。"
>
  <section class="intro projects-intro">
    <p class="eyebrow">
      <span class="en-text">Selected work</span><span class="zh-text">精选作品</span>
    </p>
    <h1><span class="en-text">Projects</span><span class="zh-text">项目</span></h1>
    <p>
      <span class="en-text">
        Things I have designed, built, and learned from, across AI research and
        personal experiments.
      </span>
      <span class="zh-text">
        我在人工智能研究与个人实验中设计、构建并从中学习的作品。
      </span>
    </p>
  </section>

  <ol class="project-list">
    {projects.map((project) => (
      <li>
        <article class="project-entry">
          <a
            class="project-image-link"
            href={project.href}
            target="_blank"
            rel="noreferrer"
            aria-label={`Visit ${project.title}`}
          >
            <img
              src={project.image}
              alt={project.imageAlt}
              width="1874"
              height="1035"
            />
          </a>
          <div class="project-entry-copy">
            <ul class="project-tags en-text" aria-label="Project categories">
              {project.tags.map((tag) => <li>{tag}</li>)}
            </ul>
            <ul class="project-tags zh-text" aria-label="项目分类">
              {project.tagsZh.map((tag) => <li>{tag}</li>)}
            </ul>
            <h2>
              <span class="en-text">{project.title}</span>
              <span class="zh-text">{project.titleZh}</span>
            </h2>
            <p class="project-description">
              <span class="en-text">{project.description}</span>
              <span class="zh-text">{project.descriptionZh}</span>
            </p>
            <p>
              <span class="en-text">{project.details}</span>
              <span class="zh-text">{project.detailsZh}</span>
            </p>
            <a
              class="project-link"
              href={project.href}
              target="_blank"
              rel="noreferrer"
            >
              <span class="en-text">Visit website</span>
              <span class="zh-text">访问网站</span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </article>
      </li>
    ))}
  </ol>
</BaseLayout>
