---
import NoteCard from "../../components/NoteCard.astro";
import { xiaohongshuPosts } from "../../data/xiaohongshu";
import PartDetailLayout from "../../layouts/PartDetailLayout.astro";

const meta = [
  { label: "Collection", labelZh: "收录", value: `${xiaohongshuPosts.length} public notes`, valueZh: `${xiaohongshuPosts.length} 篇公开随笔` },
  { label: "Source", labelZh: "来源", value: "Xiaohongshu", valueZh: "小红书" },
  { label: "Format", labelZh: "形式", value: "Images & reflections", valueZh: "图像与随想" },
];
---

<PartDetailLayout
  part="03"
  title="Notes"
  titleZh="随笔"
  eyebrow={`${xiaohongshuPosts.length} Notes from Elsewhere`}
  eyebrowZh={`${xiaohongshuPosts.length} 篇站外随笔`}
  statement="Small fragments can hold the shape of an entire season."
  statementZh="很小的片段，也能留住一整段时间的形状。"
  description="Shorter thoughts and visual records about feeling, relationships, music, games, and ordinary days. They were originally shared on Xiaohongshu, and their original Chinese is preserved here."
  descriptionZh="关于情感、关系、音乐、游戏与普通日子的短篇想法和图像记录。它们最初发布于小红书，并在这里保留中文原文。"
  image="/notes/pampas-clouds-cover.png"
  imageAlt="Pampas grass beneath bright summer clouds"
  imageAspect={1448 / 1086}
  imageWidth={52}
  imagePosition="center"
  titleLeft="8.143%"
  titleLeftZh="12.66%"
  outlineHeroTitle
  showOverview={false}
  background="#326b7e"
  foreground="#f6f2e8"
  accent="#f0d09a"
  heroBackground="#f0d09a"
  heroForeground="#111719"
  heroAccent="#111719"
  heroOutline="#111719"
  {meta}
  nextHref="/projects/tarot/"
  nextTitle="Quiet Tarot"
  nextTitleZh="静谧塔罗"
  nextImage="/projects/yucongs-tarot.jpg"
  nextImageAspect={1874 / 1035}
  nextBackground="#221e34"
  nextAccent="#b6a3a5"
  nextRail="#b6a3a5"
>
  <section class="notes-page detail-notes-collection" aria-labelledby="notes-heading" data-detail-reveal>
    <header class="notes-intro">
      <p class="notes-kicker">
        <span class="en-text">Life · Ideas · Images</span>
        <span class="zh-text">生活 · 思考 · 图像</span>
      </p>
      <h2 id="notes-heading">
        <span class="en-text">Notes from elsewhere</span>
        <span class="zh-text">站外随笔</span>
      </h2>
      <p>
        <span class="en-text">Browse the complete collection in its original order.</span>
        <span class="zh-text">按照原始顺序浏览全部记录。</span>
      </p>
    </header>

    <div class="notes-grid">
      {xiaohongshuPosts.map((post) => <NoteCard post={post} />)}
    </div>
  </section>
</PartDetailLayout>
