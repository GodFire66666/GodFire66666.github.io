---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";
import { featuredProject } from "../data/projects";
import { xiaohongshuPosts } from "../data/xiaohongshu";

const latestNote = xiaohongshuPosts[0];
const scenes = [
  {
    id: "yucong",
    eyebrow: "LLMs & Agent Training",
    eyebrowZh: "大语言模型与智能体训练",
    title: SITE.author,
    titleZh: SITE.author,
    description:
      "An algorithm engineer working on how models learn to reason, use tools, and act in complex environments.",
    descriptionZh:
      "一名算法工程师，关注模型如何学习推理、使用工具，并在复杂环境中采取行动。",
    href: "/about/",
    action: "Meet Yucong",
    actionZh: "认识 Yucong",
    image: "/hero-portrait.jpg",
    imageAlt: "Portrait of Yucong Luo in a black sweater",
    background: "#3d4545",
    foreground: "#f0ece5",
    titleColor: "#f5f0e8",
    accent: "#d8a48b",
    brightness: 1,
    scale: 1,
    rotation: 0,
    mobileX: 0,
    focusX: 0.5,
    focusY: 0.59,
    theme: "dark",
  },
  {
    id: "tarot",
    eyebrow: "Independent Web Project",
    eyebrowZh: "独立网页项目",
    title: featuredProject?.title ?? "Yucong's Tarot",
    titleZh: featuredProject?.titleZh ?? "Yucong 的塔罗牌",
    description:
      featuredProject?.description ??
      "A quiet, cinematic tarot experience designed and built from concept to deployment.",
    descriptionZh:
      featuredProject?.descriptionZh ??
      "一个安静而富有沉浸感的塔罗体验，从概念、设计到部署独立完成。",
    href: featuredProject?.href ?? "https://yucongs-tarot.netlify.app/",
    action: "Open the experience",
    actionZh: "进入体验",
    image: featuredProject?.image ?? "/projects/yucongs-tarot.jpg",
    imageAlt:
      featuredProject?.imageAlt ?? "The dark interface of Yucong's Tarot",
    background: "#221e34",
    foreground: "#eee9df",
    titleColor: "#f3ead7",
    accent: "#d6b35f",
    brightness: 1.3,
    scale: 1,
    rotation: 0,
    mobileX: 0,
    focusX: 0.5,
    focusY: 0.5,
    theme: "dark",
    external: true,
  },
  {
    id: "notes",
    eyebrow: `${xiaohongshuPosts.length} Notes from Elsewhere`,
    eyebrowZh: `${xiaohongshuPosts.length} 篇站外随笔`,
    title: "Notes",
    titleZh: "随笔",
    description:
      "Fragments about feeling, relationships, music, games, and the ordinary days worth remembering.",
    descriptionZh:
      "关于情感、关系、音乐、游戏，以及那些值得被记住的普通日子的片段。",
    href: "/notes/",
    action: "Browse all notes",
    actionZh: "浏览全部随笔",
    image:
      latestNote?.images[0] ??
      "/xiaohongshu/6a803b2c0000000026034f93/images/01.webp",
    imageAlt: latestNote?.title ?? "Cover image from Yucong's recent notes",
    background: "#dfeadf",
    foreground: "#294139",
    titleColor: "#174b34",
    accent: "#a96257",
    brightness: 1,
    scale: 1,
    rotation: 0,
    mobileX: 0,
    focusX: 0.5,
    focusY: 0.5,
    theme: "light",
  },
  {
    id: "writing",
    eyebrow: "Ideas in Progress",
    eyebrowZh: "持续生长的想法",
    title: "Writing",
    titleZh: "文章",
    description:
      "Longer notes on technology, ways of working, and questions that become clearer through writing.",
    descriptionZh:
      "关于技术、工作方法，以及那些在书写中逐渐清晰的问题的长篇记录。",
    href: "/posts/start-writing/",
    action: "Start reading",
    actionZh: "开始阅读",
    image: "/projects/writing-cover.webp",
    imageAlt: "Editorial cover for Yucong Luo's long-form writing",
    background: "#eee4e7",
    foreground: "#49343b",
    titleColor: "#4d2936",
    accent: "#a04f6a",
    brightness: 1,
    scale: 1,
    rotation: 0,
    mobileX: 0,
    focusX: 0.5,
    focusY: 0.5,
    theme: "light",
  },
];
---

<BaseLayout immersive>
  <div
    class="portfolio-home"
    data-portfolio-home
    style={`--portfolio-bg: ${scenes[0].background}; --portfolio-fg: ${scenes[0].foreground}; --portfolio-title: ${scenes[0].titleColor}; --portfolio-accent: ${scenes[0].accent};`}
  >
    <div class="portfolio-backdrop" aria-hidden="true"></div>
    <canvas class="portfolio-canvas" data-portfolio-canvas aria-hidden="true"></canvas>

    <nav class="portfolio-progress" aria-label="Homepage sections">
      {scenes.map((scene, index) => (
        <a
          href={`#${scene.id}`}
          class:list={{ active: index === 0 }}
          data-progress-index={index}
          aria-label={`Go to ${scene.title}`}
        >
          <span>{String(index + 1).padStart(2, "0")}</span>
        </a>
      ))}
    </nav>

    <div class="portfolio-scenes">
      {scenes.map((scene, index) => (
        <section
          class:list={["portfolio-scene", { active: index === 0 }]}
          id={scene.id}
          data-scene-index={index}
          data-scene-image={scene.image}
          data-scene-background={scene.background}
          data-scene-foreground={scene.foreground}
          data-scene-title={scene.titleColor}
          data-scene-accent={scene.accent}
          data-scene-brightness={scene.brightness}
          data-scene-scale={scene.scale}
          data-scene-rotation={scene.rotation}
          data-scene-mobile-x={scene.mobileX}
          data-scene-focus-x={scene.focusX}
          data-scene-focus-y={scene.focusY}
          data-scene-theme={scene.theme}
          style={`--scene-fg: ${scene.foreground}; --scene-title: ${scene.titleColor}; --scene-accent: ${scene.accent};`}
          aria-hidden={index === 0 ? "false" : "true"}
          inert={index !== 0}
          aria-labelledby={`${scene.id}-title`}
        >
          <div class="portfolio-scene-inner">
            <div class="portfolio-copy">
              <p class="portfolio-count" aria-hidden="true">
                {String(index + 1).padStart(2, "0")} / {String(scenes.length).padStart(2, "0")}
              </p>
              <p class="portfolio-eyebrow">
                <span class="en-text">{scene.eyebrow}</span>
                <span class="zh-text">{scene.eyebrowZh}</span>
              </p>
              <h1 id={`${scene.id}-title`}>
                <span class="en-text">{scene.title}</span>
                <span class="zh-text">{scene.titleZh}</span>
              </h1>
              <p class="portfolio-description">
                <span class="en-text">{scene.description}</span>
                <span class="zh-text">{scene.descriptionZh}</span>
              </p>
              <a
                class="portfolio-action"
                href={scene.href}
                target={scene.external ? "_blank" : undefined}
                rel={scene.external ? "noreferrer" : undefined}
              >
                <span class="en-text">{scene.action}</span>
                <span class="zh-text">{scene.actionZh}</span>
                <span aria-hidden="true">{scene.external ? "↗" : "→"}</span>
              </a>
              {index === 0 && (
                <div class="portfolio-socials" aria-label="Profile links">
                  <a href={SITE.github}>GitHub</a>
                  <a href={SITE.scholar}>Scholar</a>
                  <a href={SITE.xiaohongshu}>Xiaohongshu</a>
                </div>
              )}
            </div>

            <figure class="portfolio-fallback" aria-hidden="true">
              <img
                src={scene.image}
                alt={scene.imageAlt}
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : undefined}
              />
            </figure>
          </div>
        </section>
      ))}
    </div>

    <p class="portfolio-scroll-hint" aria-hidden="true">
      <span class="en-text">Scroll to explore</span>
      <span class="zh-text">向下滚动探索</span>
      <span>↓</span>
    </p>
  </div>
</BaseLayout>

<script>
  import { gsap } from "gsap";

  const home = document.querySelector<HTMLElement>("[data-portfolio-home]");
  const sceneElements = Array.from(
    document.querySelectorAll<HTMLElement>("[data-scene-index]"),
  );
  const progressLinks = Array.from(
    document.querySelectorAll<HTMLElement>("[data-progress-index]"),
  );
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const desktopReel = window.matchMedia("(min-width: 761px)");
  const hashIndex = sceneElements.findIndex((scene) => `#${scene.id}` === location.hash);
  let activeIndex = hashIndex >= 0 ? hashIndex : 0;
  let touchStartY = 0;
  let touchCurrentY = 0;

  document.documentElement.classList.add("portfolio-home-active");
  window.scrollTo(0, 0);

  function activateScene(index: number, immediate = false, direction = 1, broadcast = true) {
    const next = sceneElements[index];
    if (!home || !next) return;

    const previous = sceneElements[activeIndex];
    const previousCopy = previous?.querySelector<HTMLElement>(".portfolio-copy");
    const nextCopy = next.querySelector<HTMLElement>(".portfolio-copy");
    if (!immediate && previousCopy && previous !== next) {
      gsap.killTweensOf(previousCopy);
      gsap.to(previousCopy, {
        opacity: 0,
        y: -22 * direction,
        duration: 0.32,
        ease: "power1.in",
        overwrite: true,
      });
    }
    if (nextCopy) {
      gsap.killTweensOf(nextCopy);
      if (immediate) {
        gsap.set(nextCopy, { opacity: 1, y: 0 });
      } else {
        gsap.set(nextCopy, { opacity: 0, y: 22 * direction });
        gsap.to(nextCopy, {
          opacity: 1,
          y: 0,
          duration: 0.6,
          delay: 0.35,
          ease: "power1.out",
          overwrite: true,
        });
      }
    }

    activeIndex = index;
    sceneElements.forEach((scene, sceneIndex) => {
      scene.classList.toggle("active", sceneIndex === index);
      scene.inert = sceneIndex !== index;
      scene.setAttribute("aria-hidden", sceneIndex === index ? "false" : "true");
    });
    progressLinks.forEach((link, linkIndex) => {
      link.classList.toggle("active", linkIndex === index);
      if (linkIndex === index) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    });

    home.style.setProperty("--portfolio-bg", next.dataset.sceneBackground ?? "#202728");
    home.style.setProperty("--portfolio-fg", next.dataset.sceneForeground ?? "#f6f3ed");
    home.style.setProperty("--portfolio-title", next.dataset.sceneTitle ?? "#f6f3ed");
    home.style.setProperty("--portfolio-accent", next.dataset.sceneAccent ?? "#efb39f");
    document.documentElement.classList.toggle(
      "portfolio-theme-light",
      next.dataset.sceneTheme === "light",
    );
    home.classList.remove("portfolio-at-end");
    history.replaceState(null, "", `#${next.id}`);

    if (broadcast) {
      window.dispatchEvent(
        new CustomEvent("portfolio-scene-change", {
          detail: { index, direction, immediate, source: "page" },
        }),
      );
    }
  }

  function goToScene(index: number, immediate = false) {
    const sceneCount = sceneElements.length;
    const nextIndex = ((index % sceneCount) + sceneCount) % sceneCount;
    if (nextIndex === activeIndex && !immediate) return;

    if (
      desktopReel.matches &&
      !reducedMotion.matches &&
      home?.classList.contains("webgl-ready")
    ) {
      window.dispatchEvent(
        new CustomEvent("portfolio-reel-go-to", {
          detail: { index: nextIndex, immediate },
        }),
      );
      return;
    }

    const direction = index < activeIndex ? -1 : 1;
    activateScene(nextIndex, immediate || reducedMotion.matches, direction);
  }

  window.addEventListener("portfolio-scene-change", (event) => {
    const detail = (event as CustomEvent<{
      index: number;
      direction?: number;
      immediate?: boolean;
      source?: string;
    }>).detail;
    if (detail.source === "page") return;
    activateScene(detail.index, detail.immediate, detail.direction ?? 1, false);
  });

  window.addEventListener(
    "keydown",
    (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.matches("input, textarea, select, [contenteditable='true']")) return;

      const backward = event.key === "ArrowUp" || event.key === "PageUp" ||
        (event.key === " " && event.shiftKey);
      const forward = event.key === "ArrowDown" || event.key === "PageDown" ||
        (event.key === " " && !event.shiftKey);
      if (!backward && !forward && event.key !== "Home" && event.key !== "End") return;

      event.preventDefault();
      if (event.key === "Home") goToScene(0);
      else if (event.key === "End") goToScene(sceneElements.length - 1);
      else goToScene(activeIndex + (backward ? -1 : 1));
    },
  );
  window.addEventListener(
    "touchstart",
    (event) => {
      touchStartY = event.touches[0]?.clientY ?? 0;
      touchCurrentY = touchStartY;
    },
    { passive: true },
  );
  window.addEventListener(
    "touchmove",
    (event) => {
      if (event.touches.length > 1) return;
      event.preventDefault();
      touchCurrentY = event.touches[0]?.clientY ?? touchCurrentY;
    },
    { passive: false },
  );
  window.addEventListener("touchend", () => {
    const distance = touchStartY - touchCurrentY;
    if (Math.abs(distance) >= 32) {
      goToScene(activeIndex + (distance > 0 ? 1 : -1));
    }
  });
  progressLinks.forEach((link, index) => {
    link.addEventListener("click", (event) => {
      event.preventDefault();
      goToScene(index);
    });
  });

  sceneElements.forEach((scene, index) => {
    const copy = scene.querySelector<HTMLElement>(".portfolio-copy");
    if (copy) gsap.set(copy, { opacity: index === activeIndex ? 1 : 0, y: 0 });
  });
  activateScene(activeIndex, true);

  void import("../scripts/portfolio-reel")
    .then(({ startPortfolioReel }) => startPortfolioReel())
    .catch((error) => {
      console.error("Portfolio WebGL failed to start", error);
      home?.classList.remove("webgl-ready");
    });
</script>
