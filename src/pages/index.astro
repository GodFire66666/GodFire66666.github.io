---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";
import { featuredProject } from "../data/projects";
import { xiaohongshuPosts } from "../data/xiaohongshu";

const scenes = [
  {
    id: "yucong",
    eyebrow: "LLMs & Agent Training",
    eyebrowZh: "大语言模型与智能体训练",
    title: SITE.author,
    titleZh: SITE.authorZh,
    description:
      "An algorithm engineer working on how models learn to reason, use tools, and act in complex environments.",
    descriptionZh:
      "一名算法工程师，关注模型如何学习推理、使用工具，并在复杂环境中采取行动。",
    href: "/about/",
    action: "Meet Yucong",
    actionZh: "认识 Yucong",
    image: "/hero-portrait-centered.jpg",
    detailAspect: 1596 / 986,
    detailWidth: undefined,
    imageAlt: "Portrait of Yucong Luo in a black sweater",
    background: "#3d4545",
    foreground: "#f0ece5",
    titleColor: "#c7b8b1",
    accent: "#c7b8b1",
    rail: "#c7b8b1",
    brightness: 1,
    scale: 1,
    rotation: 0,
    mobileX: 0,
    focusX: 0.5,
    focusY: 0.5,
    detailPosition: "center 58%",
    theme: "dark",
  },
  {
    id: "photography",
    eyebrow: "Model Studies · 2021–2022",
    eyebrowZh: "模型习作 · 2021–2022",
    title: "Model Photography",
    titleZh: "模型摄影",
    description:
      "An archive of Gundam, Transformers, character figures, and small worlds shaped through posing and light.",
    descriptionZh:
      "高达、变形金刚与角色模型的摄影存档，用姿态和光线塑造微小世界。",
    href: "/photography/",
    action: "Enter the archive",
    actionZh: "进入作品档案",
    image: "/photography/rg-hi-nu/gallery/13.webp",
    detailAspect: 1600 / 1067,
    detailWidth: undefined,
    imageAlt: "RG Hi-Nu Gundam photographed against a dark background",
    background: "#172536",
    foreground: "#eef2f1",
    titleColor: "#88b2cf",
    accent: "#88b2cf",
    rail: "#88b2cf",
    brightness: 1.08,
    scale: 1,
    rotation: 0,
    mobileX: 0,
    focusX: 0.46,
    focusY: 0.46,
    detailPosition: "center",
    theme: "dark",
  },
  {
    id: "notes",
    eyebrow: `${xiaohongshuPosts.length} Notes from Elsewhere`,
    eyebrowZh: `${xiaohongshuPosts.length} 篇站外随笔`,
    title: "Notes",
    titleZh: "随笔",
    description:
      "Fragments about feeling, relationships, music, games, and the ordinary days worth remembering.",
    descriptionZh:
      "关于情感、关系、音乐、游戏，以及那些值得被记住的普通日子的片段。",
    href: "/notes/",
    action: "Browse all notes",
    actionZh: "浏览全部随笔",
    image: "/notes/pampas-clouds-cover.png",
    detailAspect: 1448 / 1086,
    detailWidth: 52,
    imageAlt: "Pampas grass beneath bright summer clouds",
    background: "#326b7e",
    foreground: "#f6f2e8",
    titleColor: "#f0d09a",
    accent: "#f0d09a",
    rail: "#f0d09a",
    brightness: 1,
    scale: 1,
    rotation: 0,
    mobileX: 0,
    focusX: 0.5,
    focusY: 0.5,
    detailPosition: "center",
    theme: "dark",
  },
  {
    id: "tarot",
    eyebrow: "Independent Web Project",
    eyebrowZh: "独立网页项目",
    title: featuredProject?.title ?? "Quiet Tarot",
    titleZh: featuredProject?.titleZh ?? "静谧塔罗",
    description:
      featuredProject?.description ??
      "A quiet, cinematic tarot experience designed and built from concept to deployment.",
    descriptionZh:
      featuredProject?.descriptionZh ??
      "一个安静而富有沉浸感的塔罗体验，从概念、设计到部署独立完成。",
    href: "/projects/tarot/",
    action: "Open the experience",
    actionZh: "进入体验",
    image: featuredProject?.image ?? "/projects/yucongs-tarot.jpg",
    detailAspect: 1874 / 1035,
    detailWidth: undefined,
    imageAlt:
      featuredProject?.imageAlt ?? "The dark interface of Quiet Tarot",
    background: "#221e34",
    foreground: "#eee9df",
    titleColor: "#b6a3a5",
    accent: "#b6a3a5",
    rail: "#b6a3a5",
    brightness: 1.3,
    scale: 1,
    rotation: 0,
    mobileX: 0,
    focusX: 0.5,
    focusY: 0.5,
    detailPosition: "center",
    theme: "dark",
    external: false,
  },
  {
    id: "writing",
    eyebrow: "Ideas in Progress",
    eyebrowZh: "持续生长的想法",
    title: "Writing",
    titleZh: "文章",
    description:
      "Longer notes on technology, ways of working, and questions that become clearer through writing.",
    descriptionZh:
      "关于技术、工作方法，以及那些在书写中逐渐清晰的问题的长篇记录。",
    href: "/posts/start-writing/",
    action: "Start reading",
    actionZh: "开始阅读",
    image: "/projects/writing-cover.webp",
    detailAspect: 4 / 3,
    detailWidth: undefined,
    imageAlt: "Editorial cover for Yucong Luo's long-form writing",
    background: "#eee4e7",
    foreground: "#49343b",
    titleColor: "#91445e",
    accent: "#91445e",
    rail: "#91445e",
    brightness: 1,
    scale: 1,
    rotation: 0,
    mobileX: 0,
    focusX: 0.5,
    focusY: 0.5,
    detailPosition: "center",
    theme: "light",
  },
];
---

<BaseLayout immersive>
  <div
    class="portfolio-home"
    data-portfolio-home
    style={`--portfolio-bg: ${scenes[0].background}; --portfolio-fg: ${scenes[0].foreground}; --portfolio-title: ${scenes[0].titleColor}; --portfolio-accent: ${scenes[0].accent}; --portfolio-rail: ${scenes[0].rail};`}
  >
    <div class="portfolio-backdrop" aria-hidden="true"></div>
    <canvas class="portfolio-canvas" data-portfolio-canvas aria-hidden="true"></canvas>

    <nav class="portfolio-progress" aria-label="Homepage sections">
      {scenes.map((scene, index) => (
        <a
          href={`#${scene.id}`}
          class:list={{ active: index === 0 }}
          data-progress-index={index}
          aria-label={`Go to ${scene.title}`}
        >
          <span class="portfolio-progress-label" aria-hidden="true">
            <span class="en-text">
              {scene.id === "yucong" ? "Yucong" : scene.title}
            </span>
            <span class="zh-text">
              {scene.id === "yucong" ? "Yucong" : scene.titleZh}
            </span>
          </span>
          <span class="portfolio-progress-index">
            {String(index + 1).padStart(2, "0")}
          </span>
        </a>
      ))}
    </nav>

    <div class="portfolio-scenes">
      {scenes.map((scene, index) => (
        <section
          class:list={["portfolio-scene", { active: index === 0 }]}
          id={scene.id}
          data-scene-index={index}
          data-scene-image={scene.image}
          data-scene-background={scene.background}
          data-scene-foreground={scene.foreground}
          data-scene-detail-foreground={scene.id === "notes" ? "#111719" : scene.id === "photography" ? "#172536" : "#ffffff"}
          data-scene-title={scene.titleColor}
          data-scene-accent={scene.accent}
          data-scene-rail={scene.rail}
          data-scene-brightness={scene.brightness}
          data-scene-scale={scene.scale}
          data-scene-rotation={scene.rotation}
          data-scene-mobile-x={scene.mobileX}
          data-scene-focus-x={scene.focusX}
          data-scene-focus-y={scene.focusY}
          data-scene-detail-position={scene.detailPosition}
          data-scene-detail-aspect={scene.detailAspect}
          data-scene-detail-width={scene.detailWidth}
          data-scene-href={scene.href}
          data-scene-external={scene.external ? "true" : "false"}
          data-scene-theme={scene.theme}
          style={`--scene-fg: ${scene.foreground}; --scene-title: ${scene.titleColor}; --scene-accent: ${scene.accent};`}
          aria-hidden={index === 0 ? "false" : "true"}
          inert={index !== 0}
          aria-labelledby={`${scene.id}-title`}
        >
          <div class="portfolio-scene-inner">
            <div class="portfolio-copy">
              <p class="portfolio-count" aria-hidden="true">
                {String(index + 1).padStart(2, "0")} / {String(scenes.length).padStart(2, "0")}
              </p>
              <p class="portfolio-eyebrow">
                <span class="en-text">{scene.eyebrow}</span>
                <span class="zh-text">{scene.eyebrowZh}</span>
              </p>
              <h1 id={`${scene.id}-title`}>
                <span class="en-text">{scene.title}</span>
                <span class="zh-text">{scene.titleZh}</span>
              </h1>
              <p class="portfolio-description">
                <span class="en-text">{scene.description}</span>
                <span class="zh-text">{scene.descriptionZh}</span>
              </p>
              <a
                class="portfolio-action"
                href={scene.href}
                data-transition-link={!scene.external ? true : undefined}
                data-transition-color={!scene.external ? scene.background : undefined}
                data-transition-accent={!scene.external ? scene.rail : undefined}
                data-transition-image={!scene.external ? scene.image : undefined}
                data-transition-position={!scene.external ? scene.detailPosition : undefined}
                data-transition-aspect={!scene.external ? scene.detailAspect : undefined}
                data-transition-width={!scene.external ? scene.detailWidth : undefined}
                target={scene.external ? "_blank" : undefined}
                rel={scene.external ? "noreferrer" : undefined}
              >
                <span class="en-text">{scene.action}</span>
                <span class="zh-text">{scene.actionZh}</span>
                <span aria-hidden="true">{scene.external ? "↗" : "→"}</span>
              </a>
              {index === 0 && (
                <div class="portfolio-socials" aria-label="Profile links">
                  <a href={SITE.github}>GitHub</a>
                  <a href={SITE.scholar}>Scholar</a>
                  <a href={SITE.xiaohongshu}>Xiaohongshu</a>
                </div>
              )}
            </div>

            <figure class="portfolio-fallback" data-route-cover aria-hidden="true">
              <img
                src={scene.image}
                alt={scene.imageAlt}
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : undefined}
              />
            </figure>
          </div>
        </section>
      ))}
    </div>

    <p class="portfolio-scroll-hint" aria-hidden="true">
      <span class="en-text">Scroll to explore</span>
      <span class="zh-text">向下滚动探索</span>
      <span>↓</span>
    </p>
  </div>

  <script is:inline data-astro-rerun>
    (() => {
      const sceneId = window.location.hash.slice(1);
      const home = document.querySelector("[data-portfolio-home]");
      const homeScenes = home
        ? Array.from(home.querySelectorAll("[data-scene-index]"))
        : [];
      const target = homeScenes.find((scene) => scene.id === (sceneId || "yucong"));
      if (!home || !target?.matches("[data-scene-index]")) return;

      const targetIndex = Number(target.dataset.sceneIndex ?? 0);
      homeScenes.forEach((scene) => {
        const active = scene === target;
        scene.classList.toggle("active", active);
        scene.toggleAttribute("inert", !active);
        scene.setAttribute("aria-hidden", active ? "false" : "true");
      });
      home.querySelectorAll("[data-progress-index]").forEach((link) => {
        const active = Number(link.dataset.progressIndex) === targetIndex;
        link.classList.toggle("active", active);
        if (active) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });

      home.style.setProperty("--portfolio-bg", target.dataset.sceneBackground);
      home.style.setProperty("--portfolio-fg", target.dataset.sceneForeground);
      home.style.setProperty("--portfolio-title", target.dataset.sceneTitle);
      home.style.setProperty("--portfolio-accent", target.dataset.sceneAccent);
      home.style.setProperty("--portfolio-rail", target.dataset.sceneRail);
      document.documentElement.classList.toggle(
        "portfolio-theme-light",
        target.dataset.sceneTheme === "light",
      );
    })();
  </script>
</BaseLayout>

<script>
  import { gsap } from "gsap";

  let homeController: AbortController | undefined;
  let initializedHome: HTMLElement | null = null;
  let reelModule: Promise<typeof import("../scripts/portfolio-reel")> | undefined;

  function loadPortfolioReel() {
    reelModule ??= import("../scripts/portfolio-reel");
    return reelModule;
  }

  function stopPortfolioHome() {
    homeController?.abort();
    homeController = undefined;
    initializedHome = null;
    void reelModule?.then(({ stopPortfolioReel }) => stopPortfolioReel());
    document.documentElement.classList.remove("portfolio-home-active");
  }

  function initializePortfolioHome() {
    const home = document.querySelector<HTMLElement>("[data-portfolio-home]");
    if (!home) {
      stopPortfolioHome();
      return;
    }
    if (home === initializedHome && !homeController?.signal.aborted) return;
    const portfolioHome = home;

    stopPortfolioHome();
    initializedHome = portfolioHome;
    homeController = new AbortController();
    const { signal } = homeController;
    const sceneElements = Array.from(
      portfolioHome.querySelectorAll<HTMLElement>("[data-scene-index]"),
    );
    const progressLinks = Array.from(
      portfolioHome.querySelectorAll<HTMLElement>("[data-progress-index]"),
    );
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    const desktopReel = window.matchMedia("(min-width: 761px)");
    const hashIndex = sceneElements.findIndex(
      (scene) => `#${scene.id}` === location.hash,
    );
    let activeIndex = hashIndex >= 0 ? hashIndex : 0;
    let touchStartY = 0;
    let touchCurrentY = 0;

    document.documentElement.classList.add("portfolio-home-active");
    window.scrollTo(0, 0);

    function activateScene(
      index: number,
      immediate = false,
      direction = 1,
      broadcast = true,
    ) {
      const next = sceneElements[index];
      if (!next || signal.aborted) return;

      const previous = sceneElements[activeIndex];
      const previousCopy = previous?.querySelector<HTMLElement>(".portfolio-copy");
      const nextCopy = next.querySelector<HTMLElement>(".portfolio-copy");
      if (!immediate && previousCopy && previous !== next) {
        gsap.killTweensOf(previousCopy);
        gsap.to(previousCopy, {
          opacity: 0,
          y: -22 * direction,
          duration: 0.32,
          ease: "power1.in",
          overwrite: true,
        });
      }
      if (nextCopy) {
        gsap.killTweensOf(nextCopy);
        if (immediate) {
          gsap.set(nextCopy, { opacity: 1, y: 0 });
        } else {
          gsap.set(nextCopy, { opacity: 0, y: 22 * direction });
          gsap.to(nextCopy, {
            opacity: 1,
            y: 0,
            duration: 0.6,
            delay: 0.35,
            ease: "power1.out",
            overwrite: true,
          });
        }
      }

      activeIndex = index;
      sceneElements.forEach((scene, sceneIndex) => {
        scene.classList.toggle("active", sceneIndex === index);
        scene.inert = sceneIndex !== index;
        scene.setAttribute("aria-hidden", sceneIndex === index ? "false" : "true");
      });
      progressLinks.forEach((link, linkIndex) => {
        link.classList.toggle("active", linkIndex === index);
        if (linkIndex === index) link.setAttribute("aria-current", "true");
        else link.removeAttribute("aria-current");
      });

      portfolioHome.style.setProperty("--portfolio-bg", next.dataset.sceneBackground ?? "#202728");
      portfolioHome.style.setProperty("--portfolio-fg", next.dataset.sceneForeground ?? "#f6f3ed");
      portfolioHome.style.setProperty("--portfolio-title", next.dataset.sceneTitle ?? "#f6f3ed");
      portfolioHome.style.setProperty("--portfolio-accent", next.dataset.sceneAccent ?? "#efb39f");
      portfolioHome.style.setProperty("--portfolio-rail", next.dataset.sceneRail ?? next.dataset.sceneAccent ?? "#efb39f");
      document.documentElement.classList.toggle(
        "portfolio-theme-light",
        next.dataset.sceneTheme === "light",
      );
      portfolioHome.classList.remove("portfolio-at-end");
      history.replaceState(history.state, "", `#${next.id}`);

      if (broadcast) {
        window.dispatchEvent(
          new CustomEvent("portfolio-scene-change", {
            detail: { index, direction, immediate, source: "page" },
          }),
        );
      }
    }

    function goToScene(index: number, immediate = false) {
      const sceneCount = sceneElements.length;
      const nextIndex = ((index % sceneCount) + sceneCount) % sceneCount;
      if (nextIndex === activeIndex && !immediate) return;

      if (
        desktopReel.matches &&
        !reducedMotion.matches &&
        portfolioHome.classList.contains("webgl-ready")
      ) {
        window.dispatchEvent(
          new CustomEvent("portfolio-reel-go-to", {
            detail: { index: nextIndex, immediate },
          }),
        );
        return;
      }

      const direction = index < activeIndex ? -1 : 1;
      activateScene(nextIndex, immediate || reducedMotion.matches, direction);
    }

    window.addEventListener("portfolio-scene-change", (event) => {
      const detail = (event as CustomEvent<{
        index: number;
        direction?: number;
        immediate?: boolean;
        source?: string;
      }>).detail;
      if (detail.source === "page") return;
      activateScene(detail.index, detail.immediate, detail.direction ?? 1, false);
    }, { signal });

    window.addEventListener("keydown", (event) => {
      const target = event.target as HTMLElement | null;
      if (target?.matches("input, textarea, select, [contenteditable='true']")) return;

      const backward = event.key === "ArrowUp" || event.key === "PageUp" ||
        (event.key === " " && event.shiftKey);
      const forward = event.key === "ArrowDown" || event.key === "PageDown" ||
        (event.key === " " && !event.shiftKey);
      if (!backward && !forward && event.key !== "Home" && event.key !== "End") return;

      event.preventDefault();
      if (event.key === "Home") goToScene(0);
      else if (event.key === "End") goToScene(sceneElements.length - 1);
      else goToScene(activeIndex + (backward ? -1 : 1));
    }, { signal });
    window.addEventListener("touchstart", (event) => {
      touchStartY = event.touches[0]?.clientY ?? 0;
      touchCurrentY = touchStartY;
    }, { passive: true, signal });
    window.addEventListener("touchmove", (event) => {
      if (event.touches.length > 1) return;
      event.preventDefault();
      touchCurrentY = event.touches[0]?.clientY ?? touchCurrentY;
    }, { passive: false, signal });
    window.addEventListener("touchend", () => {
      const distance = touchStartY - touchCurrentY;
      if (Math.abs(distance) >= 32) {
        goToScene(activeIndex + (distance > 0 ? 1 : -1));
      }
    }, { signal });
    progressLinks.forEach((link, index) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();
        goToScene(index);
      }, { signal });
    });

    sceneElements.forEach((scene, index) => {
      const copy = scene.querySelector<HTMLElement>(".portfolio-copy");
      if (copy) gsap.set(copy, { opacity: index === activeIndex ? 1 : 0, y: 0 });
    });
    activateScene(activeIndex, true);

    const signalStaticHomeReady = () => {
      requestAnimationFrame(() => {
        requestAnimationFrame(() => {
          if (signal.aborted) return;
          window.dispatchEvent(new CustomEvent("portfolio-home-ready", {
            detail: { mode: "static", sceneId: sceneElements[activeIndex]?.id },
          }));
        });
      });
    };

    if (reducedMotion.matches) {
      signalStaticHomeReady();
      return;
    }

    void loadPortfolioReel()
      .then(({ startPortfolioReel }) => {
        if (signal.aborted) return;
        return startPortfolioReel();
      })
      .catch((error) => {
        if (signal.aborted) return;
        console.error("Portfolio WebGL failed to start", error);
        portfolioHome.classList.remove("webgl-ready");
        signalStaticHomeReady();
      });
  }

  document.addEventListener("astro:page-load", initializePortfolioHome);
  document.addEventListener("astro:before-swap", stopPortfolioHome);
  initializePortfolioHome();
</script>
