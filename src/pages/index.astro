---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import NoteCard from "../components/NoteCard.astro";
import { SITE } from "../config";
import { featuredProject } from "../data/projects";
import { xiaohongshuPosts } from "../data/xiaohongshu";
import { formatDateZh, translateTag } from "../utils/i18n";
import { formatDate, sortPosts, tagPath } from "../utils/posts";

const [postEntries, postTranslations] = await Promise.all([
  getCollection("posts"),
  getCollection("postsZh"),
]);
const posts = sortPosts(postEntries.filter((post) => !post.data.draft));
const recentNotes = xiaohongshuPosts.slice(0, 3);
const translationsById = new Map(
  postTranslations.map((translation) => [translation.id, translation]),
);
const typedPhrases = {
  en: [
    "Life is lived in the journey; the result is only a postcard.",
    "Stay curious. Stay honest.",
    "Learn through uncertainty. Move forward through truth.",
    "Work with purpose. Live with attention.",
    "We write not to preserve the past, but to notice how we change.",
    "Let action answer doubt, and time test our choices.",
  ],
  zh: [
    "人生重在体验，过程是风景，结果只是明信片。",
    "保持好奇，也保持诚实。",
    "在不确定里学习，在真实中前行。",
    "认真工作，也认真生活。",
    "记录不是为了留住过去，而是为了看见自己如何改变。",
    "让行动回答犹豫，让时间验证选择。",
  ],
};
---

<BaseLayout immersive>
  <section class="immersive-hero" aria-labelledby="profile-name">
    <img
      class="hero-image"
      src="/hero-portrait.jpg"
      alt=""
      width="1920"
      height="2880"
      fetchpriority="high"
      aria-hidden="true"
    />
    <div class="hero-scrim" aria-hidden="true"></div>
    <div class="hero-inner">
      <div class="hero-copy">
        <p class="hero-eyebrow">
          <span class="en-text">LLMs · Agent Training · Notes</span>
          <span class="zh-text">大语言模型 · 智能体训练 · 随笔</span>
        </p>
        <h1 id="profile-name">{SITE.author}</h1>
        <p class="hero-role" aria-live="off">
          <span
            class="en-text typed-text"
            data-typed-language="en"
            data-phrases={JSON.stringify(typedPhrases.en)}
          >{typedPhrases.en[0]}</span>
          <span
            class="zh-text typed-text"
            data-typed-language="zh"
            data-phrases={JSON.stringify(typedPhrases.zh)}
          >{typedPhrases.zh[0]}</span>
        </p>
        <p class="hero-summary">
          <span class="en-text">
            I write about the experiments, tools, and ideas behind my work,
            alongside the things I care about beyond it.
          </span>
          <span class="zh-text">
            我记录工作中的实验、工具与想法，也分享工作之外真正在意的事物。
          </span>
        </p>
        <nav class="hero-links" aria-label="Profile links">
          <a href={SITE.github}>GitHub</a>
          <a href={SITE.scholar}>
            <span class="en-text">Scholar</span><span class="zh-text">学术主页</span>
          </a>
          <a href={SITE.xiaohongshu}>
            <span class="en-text">Xiaohongshu</span><span class="zh-text">小红书</span>
          </a>
          <a href="/about/">
            <span class="en-text">About</span><span class="zh-text">关于</span>
          </a>
        </nav>
      </div>
    </div>
    <a
      class="hero-scroll"
      href="#featured-project"
      aria-label="Scroll to featured project"
      title="Explore"
    >
      <span aria-hidden="true">↓</span>
    </a>
  </section>

  <div class="home-content">
  {featuredProject && (
    <section
      class="home-section"
      id="featured-project"
      aria-labelledby="featured-project-heading"
    >
      <div class="section-heading">
        <h2 id="featured-project-heading">
          <span class="en-text">Featured Project</span><span class="zh-text">精选项目</span>
        </h2>
        <a href="/projects/">
          <span class="en-text">All projects</span><span class="zh-text">全部项目</span>
        </a>
      </div>
      <article class="featured-project">
        <a
          class="project-image-link"
          href={featuredProject.href}
          target="_blank"
          rel="noreferrer"
          aria-label={`Visit ${featuredProject.title}`}
        >
          <img
            src={featuredProject.image}
            alt={featuredProject.imageAlt}
            width="1874"
            height="1035"
          />
        </a>
        <div class="featured-project-copy">
          <ul class="project-tags en-text" aria-label="Project categories">
            {featuredProject.tags.map((tag) => <li>{tag}</li>)}
          </ul>
          <ul class="project-tags zh-text" aria-label="项目分类">
            {featuredProject.tagsZh.map((tag) => <li>{tag}</li>)}
          </ul>
          <h3>
            <span class="en-text">{featuredProject.title}</span>
            <span class="zh-text">{featuredProject.titleZh}</span>
          </h3>
          <p>
            <span class="en-text">{featuredProject.description}</span>
            <span class="zh-text">{featuredProject.descriptionZh}</span>
          </p>
          <a
            class="project-link"
            href={featuredProject.href}
            target="_blank"
            rel="noreferrer"
          >
            <span class="en-text">Visit website</span>
            <span class="zh-text">访问网站</span>
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    </section>
  )}

  <section class="home-section" aria-labelledby="recent-notes-heading">
    <div class="section-heading">
      <h2 id="recent-notes-heading">
        <span class="en-text">Recent Notes</span><span class="zh-text">最近随笔</span>
      </h2>
      <a href="/notes/">
        <span class="en-text">All notes</span><span class="zh-text">全部随笔</span>
      </a>
    </div>
    <div class="home-notes-grid">
      {recentNotes.map((post) => <NoteCard post={post} compact />)}
    </div>
  </section>

  <section class="home-section" aria-labelledby="writing-heading">
    <div class="section-heading">
      <h2 id="writing-heading">
        <span class="en-text">Writing</span><span class="zh-text">文章</span>
      </h2>
      <a href="/tags/">
        <span class="en-text">Browse by topic</span><span class="zh-text">按主题浏览</span>
      </a>
    </div>
    <ol class="post-list">
      {posts.map((post) => {
        const translation = translationsById.get(post.id);
        return (
          <li>
            <article>
              <h2>
                <a href={`/posts/${post.id}/`}>
                  <span class="en-text">{post.data.title}</span>
                  <span class="zh-text">{translation?.data.title ?? post.data.title}</span>
                </a>
              </h2>
              <p class="summary">
                <span class="en-text">{post.data.description}</span>
                <span class="zh-text">
                  {translation?.data.description ?? post.data.description}
                </span>
              </p>
              <div class="meta">
                <time class="en-text" datetime={post.data.published.toISOString()}>
                  {formatDate(post.data.published)}
                </time>
                <time class="zh-text" datetime={post.data.published.toISOString()}>
                  {formatDateZh(post.data.published)}
                </time>
                {post.data.tags.map((tag) => (
                  <a href={tagPath(tag)}>
                    #<span class="en-text">{tag}</span><span class="zh-text">{translateTag(tag)}</span>
                  </a>
                ))}
              </div>
            </article>
          </li>
        );
      })}
    </ol>
  </section>
  </div>
</BaseLayout>

<script>
  const typedTargets = Array.from(
    document.querySelectorAll<HTMLElement>("[data-typed-language]"),
  );
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  let typingTimer: number | undefined;
  let typingRun = 0;

  function activeLanguage() {
    return document.documentElement.classList.contains("lang-zh") ? "zh" : "en";
  }

  function startTyping() {
    typingRun += 1;
    const run = typingRun;
    window.clearTimeout(typingTimer);

    const target = typedTargets.find(
      (element) => element.dataset.typedLanguage === activeLanguage(),
    );
    if (!target) return;

    const phrases = JSON.parse(target.dataset.phrases ?? "[]") as string[];
    if (phrases.length === 0) return;

    if (reducedMotion.matches) {
      target.textContent = phrases[0];
      return;
    }

    let phraseIndex = Math.floor(Math.random() * phrases.length);
    let characterIndex = 0;
    let deleting = false;
    target.textContent = "";

    const tick = () => {
      if (run !== typingRun) return;

      const characters = Array.from(phrases[phraseIndex]);
      let delay = deleting ? 28 : 55;

      if (!deleting && characterIndex < characters.length) {
        characterIndex += 1;
      } else if (!deleting) {
        deleting = true;
        delay = 1550;
      } else if (characterIndex > 0) {
        characterIndex -= 1;
      } else {
        deleting = false;
        phraseIndex = (phraseIndex + 1) % phrases.length;
        delay = 320;
      }

      target.textContent = characters.slice(0, characterIndex).join("");
      typingTimer = window.setTimeout(tick, delay);
    };

    tick();
  }

  window.addEventListener("site-language-change", startTyping);
  reducedMotion.addEventListener("change", startTyping);
  startTyping();
</script>
