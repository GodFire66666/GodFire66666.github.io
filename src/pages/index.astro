---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";
import { featuredProject } from "../data/projects";
import { xiaohongshuPosts } from "../data/xiaohongshu";

const latestNote = xiaohongshuPosts[0];
const scenes = [
  {
    id: "yucong",
    eyebrow: "LLMs & Agent Training",
    eyebrowZh: "大语言模型与智能体训练",
    title: SITE.author,
    titleZh: SITE.author,
    description:
      "An algorithm engineer working on how models learn to reason, use tools, and act in complex environments.",
    descriptionZh:
      "一名算法工程师，关注模型如何学习推理、使用工具，并在复杂环境中采取行动。",
    href: "/about/",
    action: "Meet Yucong",
    actionZh: "认识 Yucong",
    image: "/hero-portrait.jpg",
    imageAlt: "Portrait of Yucong Luo in a black sweater",
    background: "#202728",
    foreground: "#f6f3ed",
    accent: "#efb39f",
    theme: "dark",
  },
  {
    id: "tarot",
    eyebrow: "Independent Web Project",
    eyebrowZh: "独立网页项目",
    title: featuredProject?.title ?? "Yucong's Tarot",
    titleZh: featuredProject?.titleZh ?? "Yucong 的塔罗牌",
    description:
      featuredProject?.description ??
      "A quiet, cinematic tarot experience designed and built from concept to deployment.",
    descriptionZh:
      featuredProject?.descriptionZh ??
      "一个安静而富有沉浸感的塔罗体验，从概念、设计到部署独立完成。",
    href: featuredProject?.href ?? "https://yucongs-tarot.netlify.app/",
    action: "Open the experience",
    actionZh: "进入体验",
    image: featuredProject?.image ?? "/projects/yucongs-tarot.jpg",
    imageAlt:
      featuredProject?.imageAlt ?? "The dark interface of Yucong's Tarot",
    background: "#171426",
    foreground: "#faf6eb",
    accent: "#d9bd78",
    theme: "dark",
    external: true,
  },
  {
    id: "notes",
    eyebrow: `${xiaohongshuPosts.length} Notes from Elsewhere`,
    eyebrowZh: `${xiaohongshuPosts.length} 篇站外随笔`,
    title: "Notes",
    titleZh: "随笔",
    description:
      "Fragments about feeling, relationships, music, games, and the ordinary days worth remembering.",
    descriptionZh:
      "关于情感、关系、音乐、游戏，以及那些值得被记住的普通日子的片段。",
    href: "/notes/",
    action: "Browse all notes",
    actionZh: "浏览全部随笔",
    image:
      latestNote?.images[0] ??
      "/xiaohongshu/6a803b2c0000000026034f93/images/01.webp",
    imageAlt: latestNote?.title ?? "Cover image from Yucong's recent notes",
    background: "#e9f1e9",
    foreground: "#17322d",
    accent: "#347864",
    theme: "light",
  },
  {
    id: "writing",
    eyebrow: "Ideas in Progress",
    eyebrowZh: "持续生长的想法",
    title: "Writing",
    titleZh: "文章",
    description:
      "Longer notes on technology, ways of working, and questions that become clearer through writing.",
    descriptionZh:
      "关于技术、工作方法，以及那些在书写中逐渐清晰的问题的长篇记录。",
    href: "/posts/start-writing/",
    action: "Start reading",
    actionZh: "开始阅读",
    image:
      "/xiaohongshu/6a58acc200000000110153e6/images/01.webp",
    imageAlt: "A long-form note written by Yucong Luo",
    background: "#f4ecee",
    foreground: "#442b35",
    accent: "#a44867",
    theme: "light",
  },
];
---

<BaseLayout immersive>
  <div
    class="portfolio-home"
    data-portfolio-home
    style={`--portfolio-bg: ${scenes[0].background}; --portfolio-fg: ${scenes[0].foreground}; --portfolio-accent: ${scenes[0].accent};`}
  >
    <div class="portfolio-backdrop" aria-hidden="true"></div>
    <canvas class="portfolio-canvas" data-portfolio-canvas aria-hidden="true"></canvas>

    <nav class="portfolio-progress" aria-label="Homepage sections">
      {scenes.map((scene, index) => (
        <a
          href={`#${scene.id}`}
          class:list={{ active: index === 0 }}
          data-progress-index={index}
          aria-label={`Go to ${scene.title}`}
        >
          <span>{String(index + 1).padStart(2, "0")}</span>
        </a>
      ))}
    </nav>

    <div class="portfolio-scenes">
      {scenes.map((scene, index) => (
        <section
          class:list={["portfolio-scene", { active: index === 0 }]}
          id={scene.id}
          data-scene-index={index}
          data-scene-image={scene.image}
          data-scene-background={scene.background}
          data-scene-foreground={scene.foreground}
          data-scene-accent={scene.accent}
          data-scene-theme={scene.theme}
          aria-labelledby={`${scene.id}-title`}
        >
          <div class="portfolio-scene-inner">
            <div class="portfolio-copy">
              <p class="portfolio-count" aria-hidden="true">
                {String(index + 1).padStart(2, "0")} / {String(scenes.length).padStart(2, "0")}
              </p>
              <p class="portfolio-eyebrow">
                <span class="en-text">{scene.eyebrow}</span>
                <span class="zh-text">{scene.eyebrowZh}</span>
              </p>
              <h1 id={`${scene.id}-title`}>
                <span class="en-text">{scene.title}</span>
                <span class="zh-text">{scene.titleZh}</span>
              </h1>
              <p class="portfolio-description">
                <span class="en-text">{scene.description}</span>
                <span class="zh-text">{scene.descriptionZh}</span>
              </p>
              <a
                class="portfolio-action"
                href={scene.href}
                target={scene.external ? "_blank" : undefined}
                rel={scene.external ? "noreferrer" : undefined}
              >
                <span class="en-text">{scene.action}</span>
                <span class="zh-text">{scene.actionZh}</span>
                <span aria-hidden="true">{scene.external ? "↗" : "→"}</span>
              </a>
              {index === 0 && (
                <div class="portfolio-socials" aria-label="Profile links">
                  <a href={SITE.github}>GitHub</a>
                  <a href={SITE.scholar}>Scholar</a>
                  <a href={SITE.xiaohongshu}>Xiaohongshu</a>
                </div>
              )}
            </div>

            <figure class="portfolio-fallback" aria-hidden="true">
              <img
                src={scene.image}
                alt={scene.imageAlt}
                loading={index === 0 ? "eager" : "lazy"}
                fetchpriority={index === 0 ? "high" : undefined}
              />
            </figure>
          </div>
        </section>
      ))}
    </div>

    <p class="portfolio-scroll-hint" aria-hidden="true">
      <span class="en-text">Scroll to explore</span>
      <span class="zh-text">向下滚动探索</span>
      <span>↓</span>
    </p>
  </div>
</BaseLayout>

<script>
  import { gsap } from "gsap";
  import type {
    Mesh,
    MeshBasicMaterial,
    PlaneGeometry,
    ShaderMaterial,
    Texture,
  } from "three";

  const home = document.querySelector<HTMLElement>("[data-portfolio-home]");
  const canvas = document.querySelector<HTMLCanvasElement>("[data-portfolio-canvas]");
  const sceneElements = Array.from(
    document.querySelectorAll<HTMLElement>("[data-scene-index]"),
  );
  const progressLinks = Array.from(
    document.querySelectorAll<HTMLElement>("[data-progress-index]"),
  );
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const desktopCanvas = window.matchMedia("(min-width: 761px)");
  let activeIndex = 0;

  document.documentElement.classList.add("portfolio-home-active");

  function activateScene(index: number) {
    const next = sceneElements[index];
    if (!home || !next) return;

    activeIndex = index;
    sceneElements.forEach((scene, sceneIndex) => {
      scene.classList.toggle("active", sceneIndex === index);
    });
    progressLinks.forEach((link, linkIndex) => {
      link.classList.toggle("active", linkIndex === index);
      if (linkIndex === index) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    });

    home.style.setProperty("--portfolio-bg", next.dataset.sceneBackground ?? "#202728");
    home.style.setProperty("--portfolio-fg", next.dataset.sceneForeground ?? "#f6f3ed");
    home.style.setProperty("--portfolio-accent", next.dataset.sceneAccent ?? "#efb39f");
    document.documentElement.classList.toggle(
      "portfolio-theme-light",
      next.dataset.sceneTheme === "light",
    );
    home.classList.toggle("portfolio-at-end", index === sceneElements.length - 1);

    if (!reducedMotion.matches) {
      gsap.fromTo(
        next.querySelectorAll(
          ".portfolio-count, .portfolio-eyebrow, h1, .portfolio-description, .portfolio-action, .portfolio-socials",
        ),
        { y: 22, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.72, stagger: 0.055, ease: "power3.out" },
      );
    }

    window.dispatchEvent(
      new CustomEvent("portfolio-scene-change", { detail: { index } }),
    );
  }

  const observer = new IntersectionObserver(
    (entries) => {
      const visible = entries
        .filter((entry) => entry.isIntersecting)
        .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
      if (!visible) return;
      const index = Number((visible.target as HTMLElement).dataset.sceneIndex);
      if (Number.isFinite(index) && index !== activeIndex) activateScene(index);
    },
    { threshold: [0.42, 0.58, 0.72] },
  );
  sceneElements.forEach((scene) => observer.observe(scene));

  async function startWebGL() {
    if (!home || !canvas || reducedMotion.matches || !desktopCanvas.matches) return;

    const THREE = await import("three");

    const renderer = new THREE.WebGLRenderer({
      canvas,
      alpha: true,
      antialias: true,
      powerPreference: "high-performance",
    });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.75));
    renderer.outputColorSpace = THREE.SRGBColorSpace;

    const webglScene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(38, 1, 0.1, 20);
    camera.position.z = 5;
    const geometry = new THREE.PlaneGeometry(1, 1, 32, 24);
    const loader = new THREE.TextureLoader();
    const texturePaths = sceneElements.map((scene) => scene.dataset.sceneImage ?? "");
    const textures = await Promise.all(
      texturePaths.map((path) => loader.loadAsync(path)),
    );
    textures.forEach((texture) => {
      texture.colorSpace = THREE.SRGBColorSpace;
      texture.minFilter = THREE.LinearFilter;
    });

    const vertexShader = `
      uniform float uTime;
      uniform vec2 uPointer;
      varying vec2 vUv;

      void main() {
        vUv = uv;
        vec3 transformed = position;
        float arch = sin(uv.y * 3.14159265) * 0.075;
        float drift = sin((uv.x * 2.2 + uTime * 0.12) * 3.14159265) * 0.012;
        transformed.z += arch + drift;
        transformed.x += (uv.y - 0.5) * uPointer.x * 0.075;
        transformed.y += (uv.x - 0.5) * uPointer.y * 0.045;
        gl_Position = projectionMatrix * modelViewMatrix * vec4(transformed, 1.0);
      }
    `;
    const fragmentShader = `
      uniform sampler2D uTexture;
      uniform float uOpacity;
      varying vec2 vUv;

      void main() {
        vec4 color = texture2D(uTexture, vUv);
        float edge = smoothstep(0.0, 0.035, vUv.x)
          * smoothstep(1.0, 0.965, vUv.x)
          * smoothstep(0.0, 0.035, vUv.y)
          * smoothstep(1.0, 0.965, vUv.y);
        float vignette = 0.9 + 0.1 * (1.0 - distance(vUv, vec2(0.5)));
        gl_FragColor = vec4(color.rgb * vignette, color.a * uOpacity * edge);
      }
    `;

    const groups = textures.map((texture, index) => {
      const group = new THREE.Group();
      const shadow = new THREE.Mesh(
        geometry,
        new THREE.MeshBasicMaterial({
          color: 0x050505,
          transparent: true,
          opacity: index === 0 ? 0.22 : 0,
          depthWrite: false,
        }),
      );
      shadow.position.set(0.08, -0.09, -0.12);
      shadow.scale.set(1.025, 1.025, 1);

      const material = new THREE.ShaderMaterial({
        uniforms: {
          uTexture: { value: texture },
          uOpacity: { value: index === 0 ? 1 : 0 },
          uTime: { value: 0 },
          uPointer: { value: new THREE.Vector2() },
        },
        vertexShader,
        fragmentShader,
        transparent: true,
        depthWrite: false,
      });
      const mesh = new THREE.Mesh(geometry, material);
      group.add(shadow, mesh);
      group.userData = { mesh, shadow, material, texture };
      group.rotation.z = index % 2 === 0 ? -0.035 : 0.035;
      webglScene.add(group);
      return group;
    });

    const pointer = new THREE.Vector2();
    const smoothedPointer = new THREE.Vector2();

    function resize() {
      const width = window.innerWidth;
      const height = window.innerHeight;
      renderer.setSize(width, height, false);
      camera.aspect = width / height;
      camera.updateProjectionMatrix();

      const visibleHeight =
        2 * Math.tan(THREE.MathUtils.degToRad(camera.fov / 2)) * camera.position.z;
      const visibleWidth = visibleHeight * camera.aspect;
      groups.forEach((group) => {
        const texture = group.userData.texture as Texture;
        const image = texture.image as { width: number; height: number };
        const imageAspect = image.width / image.height;
        const maxWidth = visibleWidth * 0.47;
        const maxHeight = visibleHeight * 0.64;
        let planeWidth = maxWidth;
        let planeHeight = planeWidth / imageAspect;
        if (planeHeight > maxHeight) {
          planeHeight = maxHeight;
          planeWidth = planeHeight * imageAspect;
        }
        group.scale.set(planeWidth, planeHeight, 1);
        group.position.set(visibleWidth * 0.235, 0, 0);
      });
    }

    function transitionTo(index: number) {
      groups.forEach((group, groupIndex) => {
        const material = group.userData.material as ShaderMaterial;
        const shadow = group.userData.shadow as Mesh<PlaneGeometry, MeshBasicMaterial>;
        const isCurrent = groupIndex === index;
        gsap.to(material.uniforms.uOpacity, {
          value: isCurrent ? 1 : 0,
          duration: 0.7,
          ease: "power2.inOut",
        });
        gsap.to(shadow.material, {
          opacity: isCurrent ? 0.22 : 0,
          duration: 0.7,
          ease: "power2.inOut",
        });
        if (isCurrent) {
          gsap.fromTo(
            group.rotation,
            { y: -0.12, z: groupIndex % 2 === 0 ? -0.075 : 0.075 },
            {
              y: 0,
              z: groupIndex % 2 === 0 ? -0.035 : 0.035,
              duration: 0.9,
              ease: "power3.out",
            },
          );
          gsap.fromTo(
            group.position,
            { y: -0.22 },
            { y: 0, duration: 0.9, ease: "power3.out" },
          );
        }
      });
    }

    window.addEventListener(
      "pointermove",
      (event) => {
        pointer.set(
          (event.clientX / window.innerWidth) * 2 - 1,
          -(event.clientY / window.innerHeight) * 2 + 1,
        );
      },
      { passive: true },
    );
    window.addEventListener("resize", resize, { passive: true });
    window.addEventListener("portfolio-scene-change", (event) => {
      const index = (event as CustomEvent<{ index: number }>).detail.index;
      transitionTo(index);
    });

    const timer = new THREE.Timer();
    timer.connect(document);
    function render(timestamp: number) {
      timer.update(timestamp);
      const elapsed = timer.getElapsed();
      smoothedPointer.lerp(pointer, 0.055);
      groups.forEach((group) => {
        const material = group.userData.material as ShaderMaterial;
        material.uniforms.uTime.value = elapsed;
        material.uniforms.uPointer.value.copy(smoothedPointer);
      });
      renderer.render(webglScene, camera);
      window.requestAnimationFrame(render);
    }

    resize();
    transitionTo(activeIndex);
    home.classList.add("webgl-ready");
    window.requestAnimationFrame(render);
  }

  startWebGL().catch(() => {
    home?.classList.remove("webgl-ready");
  });
</script>
