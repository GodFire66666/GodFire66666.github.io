---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config";
import { featuredProject } from "../data/projects";
import { formatDate, sortPosts, tagPath } from "../utils/posts";

const posts = sortPosts(
  (await getCollection("posts")).filter((post) => !post.data.draft),
);
---

<BaseLayout>
  <section class="profile-intro" aria-labelledby="profile-name">
    <div class="profile-copy">
      <p class="eyebrow">LLMs, agent training, and notes in public</p>
      <h1 id="profile-name">{SITE.author}</h1>
      <p class="profile-role">LLMs · Agent Training</p>
      <p class="profile-summary">
        I work on LLMs and agent training, and write about the data,
        experiments, and lessons behind building better agents.
      </p>
      <nav class="profile-links" aria-label="Profile links">
        <a href={SITE.github}>GitHub</a>
        <a href={SITE.scholar}>Google Scholar</a>
        <a href={SITE.xiaohongshu}>Xiaohongshu</a>
        <a href="/about/">About</a>
        <a href="/rss.xml">RSS</a>
      </nav>
    </div>
    <img
      class="profile-photo"
      src="/avatar.jpg"
      alt="Yucong Luo"
      width="160"
      height="160"
    />
  </section>

  {featuredProject && (
    <section class="home-section" aria-labelledby="featured-project-heading">
      <div class="section-heading">
        <h2 id="featured-project-heading">Featured Project</h2>
        <a href="/projects/">All projects</a>
      </div>
      <article class="featured-project">
        <a
          class="project-image-link"
          href={featuredProject.href}
          target="_blank"
          rel="noreferrer"
          aria-label={`Visit ${featuredProject.title}`}
        >
          <img
            src={featuredProject.image}
            alt={featuredProject.imageAlt}
            width="1874"
            height="1035"
          />
        </a>
        <div class="featured-project-copy">
          <ul class="project-tags" aria-label="Project categories">
            {featuredProject.tags.map((tag) => <li>{tag}</li>)}
          </ul>
          <h3>{featuredProject.title}</h3>
          <p>{featuredProject.description}</p>
          <a
            class="project-link"
            href={featuredProject.href}
            target="_blank"
            rel="noreferrer"
          >
            Visit website <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    </section>
  )}

  <section class="home-section" aria-labelledby="writing-heading">
    <div class="section-heading">
      <h2 id="writing-heading">Writing</h2>
      <a href="/tags/">Browse by topic</a>
    </div>
    <ol class="post-list">
      {posts.map((post) => (
        <li>
          <article>
            <h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2>
            <p class="summary">{post.data.description}</p>
            <div class="meta">
              <time datetime={post.data.published.toISOString()}>
                {formatDate(post.data.published)}
              </time>
              {post.data.tags.map((tag) => (
                <a href={tagPath(tag)}>#{tag}</a>
              ))}
            </div>
          </article>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>
