---
import { SITE } from "../config";

interface Props {
  detail?: boolean;
  detailReturnColor?: string;
  overlay?: boolean;
}

const { detail = false, detailReturnColor = "#3d4545", overlay = false } = Astro.props;
const detailPath = Astro.url.pathname;
const detailReturnScene = detailPath.startsWith("/projects/tarot/")
  ? "tarot"
  : detailPath.startsWith("/photography/")
    ? "photography"
  : detailPath.startsWith("/notes/")
    ? "notes"
    : detailPath.startsWith("/posts/")
      ? "writing"
      : "yucong";
const detailReturnHref = `/#${detailReturnScene}`;
---

<header class:list={["site-header", { "site-header--detail": detail, "site-header--overlay": overlay }]}>
  <a
    class:list={["site-title", { "detail-back-home": detail }]}
    href={detail ? detailReturnHref : "/"}
    data-transition-link={detail ? true : undefined}
    data-transition-color={detail ? detailReturnColor : undefined}
    data-detail-return={detail ? true : undefined}
  >
    {detail ? (
      <>
        <span aria-hidden="true">←</span>
        <span class="en-text">Back home</span>
        <span class="zh-text">返回首页</span>
      </>
    ) : (
      <>
        <span class="en-text">{SITE.author}</span>
        <span class="zh-text">{SITE.authorZh}</span>
      </>
    )}
  </a>
  <nav aria-label="Primary navigation">
    {!detail && (
      <>
        <a href="/projects/">
          <span class="en-text">Projects</span><span class="zh-text">项目</span>
        </a>
        <a href="/photography/">
          <span class="en-text">Photography</span><span class="zh-text">摄影</span>
        </a>
        <a href="/about/">
          <span class="en-text">About</span><span class="zh-text">关于</span>
        </a>
        <a href="/notes/">
          <span class="en-text">Notes</span><span class="zh-text">随笔</span>
        </a>
        <a href="/tags/">
          <span class="en-text">Tags</span><span class="zh-text">标签</span>
        </a>
        <a href={SITE.github}>GitHub</a>
      </>
    )}
    {detail && (
      <a href="/about/" data-transition-link data-transition-color="#3d4545" data-transition-accent="#c7b8b1">
        <span class="en-text">About</span><span class="zh-text">关于</span>
      </a>
    )}
    <button
      class="language-toggle"
      type="button"
      aria-label="Switch to Chinese"
      data-language-toggle
    >
      <span class="language-option" data-language-option="en">A</span>
      <span class="language-option" data-language-option="zh">文</span>
    </button>
  </nav>
</header>
{detail && <div class="detail-back-edge" aria-hidden="true"></div>}

<script>
  const languageKey = "yucong-site-language";
  let headerController: AbortController | undefined;

  function initializeHeader() {
    headerController?.abort();
    headerController = new AbortController();
    const { signal } = headerController;
    const root = document.documentElement;
    const toggle = document.querySelector<HTMLButtonElement>(
      "[data-language-toggle]",
    );
    const detailReturnLink = document.querySelector<HTMLAnchorElement>(
      "[data-detail-return]",
    );

    if (detailReturnLink) {
      try {
        const savedReturn = JSON.parse(
          sessionStorage.getItem("yucong-detail-return") ?? "null",
        ) as { detailPath?: string; returnHref?: string } | null;
        if (
          savedReturn?.detailPath === window.location.pathname &&
          /^\/#(?:yucong|tarot|notes|writing|photography)$/.test(savedReturn.returnHref ?? "")
        ) {
          detailReturnLink.href = savedReturn.returnHref ?? detailReturnLink.href;
          detailReturnLink.dataset.historyReturn = "true";
        }
      } catch {
        // The server-rendered scene link remains a complete fallback.
      }
    }

    function currentLanguage() {
      return root.classList.contains("lang-zh") ? "zh" : "en";
    }

    function applyLanguage(language: "en" | "zh") {
      root.classList.toggle("lang-en", language === "en");
      root.classList.toggle("lang-zh", language === "zh");
      root.lang = language === "zh" ? "zh-CN" : "en";

      const title = document.body.dataset[`title${language === "zh" ? "Zh" : "En"}`];
      const description =
        document.body.dataset[`description${language === "zh" ? "Zh" : "En"}`];
      if (title) document.title = title;
      if (description) {
        document
          .querySelector('meta[name="description"]')
          ?.setAttribute("content", description);
      }

      toggle?.querySelectorAll<HTMLElement>("[data-language-option]").forEach(
        (option) => {
          option.classList.toggle(
            "active",
            option.dataset.languageOption === language,
          );
        },
      );

      if (toggle) {
        toggle.setAttribute(
          "aria-label",
          language === "en" ? "Switch to Chinese" : "切换到英文",
        );
      }

      window.dispatchEvent(
        new CustomEvent("site-language-change", { detail: { language } }),
      );
    }

    applyLanguage(currentLanguage());

    toggle?.addEventListener("click", () => {
      const nextLanguage = currentLanguage() === "en" ? "zh" : "en";
      applyLanguage(nextLanguage);
      try {
        localStorage.setItem(languageKey, nextLanguage);
      } catch {
        // The language still switches when storage is unavailable.
      }
    }, { signal });
  }

  document.addEventListener("astro:page-load", initializeHeader);
  initializeHeader();
</script>
